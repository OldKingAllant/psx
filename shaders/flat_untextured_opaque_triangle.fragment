#version 430 core

const uint NUM_RINGBUFFER_SLOTS = 64;

struct UniformBufferSlot {
	bool use_dither;
	uint tex_window_mask_x;
	uint tex_window_mask_y;
	uint tex_window_off_x;
	uint tex_window_off_y;
	int draw_x_off;
	int draw_y_off;
	bool set_mask;
	bool check_mask;
	uint resolution_multiplier;
};

layout(std140, binding = 2) uniform globals {
	UniformBufferSlot draw_config_buffer[NUM_RINGBUFFER_SLOTS];
};

layout(binding = 3, r8) uniform restrict coherent image2D mask_image;

in flat uvec3 in_color;
in vec2 coords;
in flat uint conf_slot_id;

layout(location = 0) out vec4 out_color;

void main() {
	uint x = uint(coords.x); 
	uint y = uint(coords.y); 

	if(draw_config_buffer[conf_slot_id].check_mask) {
		if(imageLoad(mask_image, ivec2(x, y)).r == 1.0) {
			discard;
		}
	}

	out_color = vec4(
		float((in_color.r >> 3) & 0x1F) / 31.0,
		float((in_color.g >> 3) & 0x1F) / 31.0,
		float((in_color.b >> 3) & 0x1F) / 31.0,
		0.0
	);

	if(draw_config_buffer[conf_slot_id].set_mask) {
		out_color.a = 1.0;
	}

	imageStore(mask_image, ivec2(x, y), vec4(out_color.a, 0.0, 0.0, 0.0));
	memoryBarrierImage();
}